# Copy this file to `.env` for local development.

# Browser-safe public Supabase values (safe to build into the SPA)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional standalone /api base URL.
# Leave empty on GitHub Pages so paid checkout calls Supabase Edge Functions
# (${VITE_SUPABASE_URL}/functions/v1/zengapay-collect & zengapay-status).
VITE_API_BASE_URL=

# Server-only secrets — NEVER prefix these with VITE_.
# Set these in Supabase Edge Function secrets (or server environment for `npm run dev:api`):
ZENGAPAY_API_KEY=ZPYPUBK-replace_me
ZENGAPAY_WEBHOOK_SECRET=replace_with_zengapay_developer_settings_secret_hash
# Production: https://api.zengapay.com/v1 (default)
# Sandbox:    https://api.sandbox.zengapay.com/v1
ZENGAPAY_BASE_URL=https://api.zengapay.com/v1
# Optional: pass collection fee onto the customer ("true" or "false", default false)
ZENGAPAY_CHARGE_CUSTOMER=false

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
ADMIN_EMAIL=admin@tanktickets.site

# Optional automatic post-payment ticket delivery secrets (Supabase Edge Function `ticket-delivery`)
# RESEND_API_KEY=re_replace_me
# EMAIL_FROM="TANK Tickets <tickets@tanktickets.site>"
# EMAIL_REPLY_TO=support@tanktickets.site
# WHATSAPP_ACCESS_TOKEN=replace_me
# WHATSAPP_PHONE_NUMBER_ID=replace_me
# WHATSAPP_TEMPLATE_NAME=tank_ticket_confirmed
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# TICKET_PUBLIC_URL=https://tanktickets.site
