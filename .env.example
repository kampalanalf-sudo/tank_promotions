# Public browser configuration (safe to expose)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
VITE_BUILD_SHA=development

# Base URL of the deployed server-only payments API.
# Leave empty for local dev so Vite proxies /api to http://127.0.0.1:8787.
# Production example: https://api.tanktickets.site
VITE_API_BASE_URL=

# Hosted DGateway store for paid "Get tickets" clicks.
# Defaults to https://dgatewayadmin.desispay.com/store/shop/tanktickets?products
# Set to off to use the in-app API checkout instead.
VITE_DGATEWAY_STORE_URL=https://dgatewayadmin.desispay.com/store/shop/tanktickets?products

# Server-only payments API configuration. NEVER prefix these with VITE_.
DGATEWAY_API_URL=https://dgatewayapi.desispay.com
DGATEWAY_API_KEY=
DGATEWAY_WEBHOOK_SECRET=
# Supabase Edge Functions for hosted DGateway store fulfilment
DGATEWAY_STORE_SLUG=tanktickets
DGATEWAY_ALLOW_TEST_PAYMENTS=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
ADMIN_EMAIL=admin@tanktickets.site

# Automatic ticket delivery (Supabase Edge Function secrets; never VITE_).
# Email via Resend. Verify the sending domain in Resend before using EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=TANK Tickets <tickets@tanktickets.site>
EMAIL_REPLY_TO=
# WhatsApp via Meta WhatsApp Cloud API. The template must be approved by Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Comma-separated body variables in the exact order used by the approved template.
WHATSAPP_TEMPLATE_BODY_FIELDS=name,event_title,event_date,ticket_code,ticket_url,pdf_url
TICKET_PUBLIC_URL=https://tanktickets.site

# Public origin used for DGateway callback_url.
# If the API is separate from the frontend, this must be the API origin,
# e.g. https://api.tanktickets.site, not the GitHub Pages frontend origin.
API_PUBLIC_URL=https://YOUR_PUBLIC_API_HOST
APP_URL=https://YOUR_PUBLIC_API_HOST
PORT=8787
