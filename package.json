{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:server": "npx --yes deno@2.5.6 test --no-lock --allow-env=DGATEWAY_API_URL,DGATEWAY_WEBHOOK_SECRET tests/server",
    "check:server": "npx --yes deno@2.5.6 check --no-lock supabase/functions/dgateway-collect/index.ts supabase/functions/dgateway-status/index.ts supabase/functions/dgateway-webhook/index.ts",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "2.1.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22.19.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^5.1.0"
  }
}
