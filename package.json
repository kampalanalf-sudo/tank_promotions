{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/dev.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run typecheck:api && npm test && npm run build",
    "test:server": "vitest run tests/server",
    "check:server": "npm run typecheck:api",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "2.1.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^1.4.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22.19.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^5.1.0"
  }
}
