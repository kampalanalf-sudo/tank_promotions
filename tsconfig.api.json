{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": [
    "server",
    "api",
    "supabase/functions/_shared/zengapay.ts",
    "supabase/functions/_shared/deliveryCore.ts",
    "supabase/functions/_shared/deliveryTrigger.ts",
    "src/lib/ticketDocument.ts"
  ]
}
